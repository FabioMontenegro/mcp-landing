---
import type { LandingT } from '../i18n/es';

interface Props {
  t: LandingT;
}

const { t } = Astro.props;
---

<!doctype html>
<html lang={t.lang} dir={t.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={t.lang === 'en' ? 'https://mcp.fabiomontenegro.com/en/' : 'https://mcp.fabiomontenegro.com/'} />
    <link rel="alternate" hreflang="es" href="https://mcp.fabiomontenegro.com/" />
    <link rel="alternate" hreflang="en" href="https://mcp.fabiomontenegro.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://mcp.fabiomontenegro.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
/* ── Tokens ─────────────────────────────── */
:root {
  --accent:     #06D6A0;
  --accent-dim: rgba(6,214,160,.13);
  --accent-h:   #04B589;
  --ink:        #0D1421;
  --ink-2:      #3C4F64;
  --fog:        #8A97AA;
  --paper:      #F4F6FA;
  --surface:    #FFFFFF;
  --border:     rgba(13,20,33,.09);
  --sh:         0 1px 4px rgba(13,20,33,.07),0 4px 16px rgba(13,20,33,.05);
  --mono: ui-monospace,'SF Mono','Cascadia Code','Fira Code',Menlo,'Courier New',monospace;
  --sans: system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --r: 8px; --r-lg: 14px;
}
@media(prefers-color-scheme:dark){:root{
  --ink:#DDE4F0; --ink-2:#96A8BE; --fog:#59697D;
  --paper:#0B1120; --surface:#111D2E; --border:rgba(255,255,255,.07);
  --sh:0 1px 4px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.25);
}}
:root[data-theme="dark"]{
  --ink:#DDE4F0; --ink-2:#96A8BE; --fog:#59697D;
  --paper:#0B1120; --surface:#111D2E; --border:rgba(255,255,255,.07);
  --sh:0 1px 4px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.25);
}
:root[data-theme="light"]{
  --ink:#0D1421; --ink-2:#3C4F64; --fog:#8A97AA;
  --paper:#F4F6FA; --surface:#FFFFFF; --border:rgba(13,20,33,.09);
  --sh:0 1px 4px rgba(13,20,33,.07),0 4px 16px rgba(13,20,33,.05);
}

/* ── Reset ──────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--sans);background:var(--paper);color:var(--ink);line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
ul{list-style:none}

/* ── Helpers ────────────────────────────── */
.wrap{max-width:1100px;margin:0 auto;padding:0 1.5rem}
.eyebrow{font-family:var(--mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--accent)}
.sec-head{margin-bottom:2.75rem}
.sec-head h2{font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;line-height:1.2;text-wrap:balance;margin:.5rem 0 .6rem}
.sec-head p{font-size:1rem;color:var(--ink-2);max-width:52ch}

/* ── Buttons ────────────────────────────── */
.btn{display:inline-flex;align-items:center;gap:.35rem;padding:.6rem 1.2rem;border-radius:var(--r);font-size:.845rem;font-weight:600;border:none;cursor:pointer;transition:all .15s}
.btn-primary{background:var(--accent);color:#0D1421}
.btn-primary:hover{background:var(--accent-h);transform:translateY(-1px)}
.btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--border)}
.btn-ghost:hover{border-color:var(--fog)}

/* ── Responsive ─────────────────────────── */
@media(max-width:860px){
  .hero-inner{grid-template-columns:1fr !important;gap:3rem}
  .stats-grid{grid-template-columns:repeat(2,1fr) !important;gap:1.5rem}
  .compare-grid{grid-template-columns:1fr !important}
  .col+.col{border-left:none !important;border-top:1px solid var(--border)}
  .steps{grid-template-columns:1fr !important;gap:2rem}
  .cases-grid{grid-template-columns:1fr !important}
}
@media(max-width:600px){
  .nav-links{display:none !important}
  .cat-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}
}
</style>
