---
import type { LandingT } from '../i18n/es';

interface Props {
  t: LandingT;
  title?: string;
  description?: string;
  /** Page path without leading slash or language prefix, e.g. "abilities/". Empty for home. */
  path?: string;
}

const { t, title = t.meta.title, description = t.meta.description, path = '' } = Astro.props;
const origin = 'https://mcp.fabiomontenegro.com';
const enUrl = `${origin}/${path}`;
const esUrl = `${origin}/es/${path}`;
const pageUrl = t.lang === 'es' ? esUrl : enUrl;
const ogImage = `${origin}/og-${t.lang === 'es' ? 'es' : 'en'}.png`;
const ogAlt = t.lang === 'es'
  ? 'Un plugin para gobernarlos a todos: Enable Abilities for MCP conecta las abilities de WordPress, Elementor, Bricks y Fluent Forms con Claude, ChatGPT y Cursor.'
  : 'One plugin to rule them all: Enable Abilities for MCP connects abilities from WordPress, Elementor, Bricks and Fluent Forms to Claude, ChatGPT and Cursor.';
---

<!doctype html>
<html lang={t.lang} dir={t.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Enable Abilities for MCP" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={t.lang === 'es' ? 'es_LA' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <script is:inline src="https://storage.ko-fi.com/cdn/scripts/overlay-widget.js"></script>
    <script is:inline>
      kofiWidgetOverlay.draw('fabiomontenegro', {
        'type': 'floating-chat',
        'floating-chat.donateButton.text': 'Support me',
        'floating-chat.donateButton.background-color': '#ffffff',
        'floating-chat.donateButton.text-color': '#323842',
      });
    </script>
  </body>
</html>

<style is:global>
/* ── Tokens ─────────────────────────────── */
:root {
  --accent:     #06D6A0;
  --accent-dim: rgba(6,214,160,.13);
  --accent-h:   #04B589;
  --ink:        #0D1421;
  --ink-2:      #3C4F64;
  --fog:        #8A97AA;
  --paper:      #F4F6FA;
  --surface:    #FFFFFF;
  --border:     rgba(13,20,33,.09);
  --sh:         0 1px 4px rgba(13,20,33,.07),0 4px 16px rgba(13,20,33,.05);
  --mono: ui-monospace,'SF Mono','Cascadia Code','Fira Code',Menlo,'Courier New',monospace;
  --sans: system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --r: 8px; --r-lg: 14px;
  /* Ability type pills (semantic, separate from the accent) */
  --t-read-fg:#0B6B4E;  --t-read-bg:rgba(11,107,78,.10);  --t-read-bd:rgba(11,107,78,.28);
  --t-write-fg:#8A4B00; --t-write-bg:rgba(217,119,6,.12); --t-write-bd:rgba(180,95,0,.32);
  --t-destr-fg:#B42318; --t-destr-bg:rgba(220,38,38,.09); --t-destr-bd:rgba(180,35,24,.30);
}
@media(prefers-color-scheme:dark){:root{
  --ink:#DDE4F0; --ink-2:#96A8BE; --fog:#59697D;
  --paper:#0B1120; --surface:#111D2E; --border:rgba(255,255,255,.07);
  --sh:0 1px 4px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.25);
  --t-read-fg:#5EE0B5;  --t-read-bg:rgba(94,224,181,.10);  --t-read-bd:rgba(94,224,181,.28);
  --t-write-fg:#F5B454; --t-write-bg:rgba(245,180,84,.10); --t-write-bd:rgba(245,180,84,.30);
  --t-destr-fg:#FF8A80; --t-destr-bg:rgba(255,138,128,.10); --t-destr-bd:rgba(255,138,128,.30);
}}
:root[data-theme="dark"]{
  --ink:#DDE4F0; --ink-2:#96A8BE; --fog:#59697D;
  --paper:#0B1120; --surface:#111D2E; --border:rgba(255,255,255,.07);
  --sh:0 1px 4px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.25);
  --t-read-fg:#5EE0B5;  --t-read-bg:rgba(94,224,181,.10);  --t-read-bd:rgba(94,224,181,.28);
  --t-write-fg:#F5B454; --t-write-bg:rgba(245,180,84,.10); --t-write-bd:rgba(245,180,84,.30);
  --t-destr-fg:#FF8A80; --t-destr-bg:rgba(255,138,128,.10); --t-destr-bd:rgba(255,138,128,.30);
}
:root[data-theme="light"]{
  --ink:#0D1421; --ink-2:#3C4F64; --fog:#8A97AA;
  --paper:#F4F6FA; --surface:#FFFFFF; --border:rgba(13,20,33,.09);
  --sh:0 1px 4px rgba(13,20,33,.07),0 4px 16px rgba(13,20,33,.05);
  --t-read-fg:#0B6B4E;  --t-read-bg:rgba(11,107,78,.10);  --t-read-bd:rgba(11,107,78,.28);
  --t-write-fg:#8A4B00; --t-write-bg:rgba(217,119,6,.12); --t-write-bd:rgba(180,95,0,.32);
  --t-destr-fg:#B42318; --t-destr-bg:rgba(220,38,38,.09); --t-destr-bd:rgba(180,35,24,.30);
}

/* ── Reset ──────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--sans);background:var(--paper);color:var(--ink);line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
ul{list-style:none}

/* ── Helpers ────────────────────────────── */
.wrap{max-width:1100px;margin:0 auto;padding:0 1.5rem}
.eyebrow{font-family:var(--mono);font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:600;color:var(--accent)}
.sec-head{margin-bottom:2.75rem}
.sec-head h2{font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;line-height:1.2;text-wrap:balance;margin:.5rem 0 .6rem}
.sec-head p{font-size:1rem;color:var(--ink-2);max-width:52ch}

/* ── Buttons ────────────────────────────── */
.btn{display:inline-flex;align-items:center;gap:.35rem;padding:.6rem 1.2rem;border-radius:var(--r);font-size:.845rem;font-weight:600;border:none;cursor:pointer;transition:all .15s}
.btn-primary{background:var(--accent);color:#0D1421}
.btn-primary:hover{background:var(--accent-h);transform:translateY(-1px)}
.btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--border)}
.btn-ghost:hover{border-color:var(--fog)}

/* ── Responsive ─────────────────────────── */
@media(max-width:860px){
  .hero-inner{grid-template-columns:1fr !important;gap:3rem}
  .stats-grid{grid-template-columns:repeat(2,1fr) !important;gap:1.5rem}
  .compare-grid{grid-template-columns:1fr !important}
  .col+.col{border-left:none !important;border-top:1px solid var(--border)}
  .steps{grid-template-columns:1fr !important;gap:2rem}
  .cases-grid{grid-template-columns:1fr !important}
}
@media(max-width:600px){
  .nav-links{display:none !important}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{transition-duration:.01ms !important;animation-duration:.01ms !important}
}
</style>
