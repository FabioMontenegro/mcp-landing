---
import type { LandingT } from '../i18n/es';
interface Props { t: LandingT }
const { t } = Astro.props;
const c = t.compare;
---
<section class="compare">
  <div class="wrap">
    <div class="compare-head">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2>{c.h2}</h2>
    </div>
    <div class="compare-grid">
      <div class="col col-bad">
        <div class="col-label">{c.without.label}</div>
        {c.without.items.map(item => (
          <div class="row"><span class="ic">✕</span>{item}</div>
        ))}
      </div>
      <div class="col col-good">
        <div class="col-label">{c.with.label}</div>
        {c.with.items.map(item => (
          <div class="row"><span class="ic good">✓</span>{item}</div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.compare{padding:5rem 0}
.compare-head{text-align:center;margin-bottom:2.75rem}
.compare-head h2{font-size:clamp(1.5rem,3vw,2.25rem);font-weight:700;line-height:1.2;text-wrap:balance;margin-top:.5rem}
.compare-grid{display:grid;grid-template-columns:1fr 1fr;max-width:860px;margin:0 auto;border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden}
.col{padding:2rem 1.75rem;background:var(--surface)}
.col+.col{border-left:1px solid var(--border)}
.col-label{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;font-weight:600;margin-bottom:1.25rem}
.col-bad .col-label{color:var(--fog)}
.col-good .col-label{color:var(--accent)}
.row{display:flex;gap:.6rem;align-items:flex-start;margin-bottom:.65rem;font-size:.9rem;color:var(--ink-2)}
.ic{flex-shrink:0;margin-top:2px;font-size:.85rem;font-family:var(--mono)}
.ic.good{color:var(--accent)}
</style>
