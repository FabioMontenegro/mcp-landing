---
import type { LandingT } from '../i18n/es';
interface Props { t: LandingT }
const { t } = Astro.props;
---
<section class="cta-band">
  <div class="wrap">
    <h2>{t.cta.h2}</h2>
    <p>{t.cta.p}</p>
    <a href="https://wordpress.org/plugins/enable-abilities-for-mcp/" class="btn btn-primary">{t.cta.btn}</a>
    <div class="cta-meta">{t.cta.meta}</div>
  </div>
</section>

<style>
.cta-band{padding:5rem 0;text-align:center;background:#0D1421}
.cta-band h2{color:#fff;font-size:clamp(1.5rem,3vw,2.25rem);margin-bottom:.75rem}
.cta-band p{color:#7A8FA8;max-width:44ch;margin:0 auto 2rem}
.cta-band .btn-primary{font-size:.95rem;padding:.75rem 1.6rem}
.cta-meta{margin-top:1.25rem;font-size:.75rem;color:#3D5060;font-family:var(--mono)}
</style>
