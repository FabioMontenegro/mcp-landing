---
import type { LandingT } from '../i18n/es';
interface Props { t: LandingT; path?: string }
const { t, path = '' } = Astro.props;
const isEn = t.lang === 'en';
---
<nav>
  <div class="nav-inner">
    <div class="nav-logo"><span class="sp">⚡</span> {t.nav.logo}</div>
    <div class="nav-links">
      {t.nav.links.map(l => (
        <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>
          {l.label}
        </a>
      ))}
    </div>
    <div class="lang-toggle" aria-label="Language">
      <a href={`/${path}`} class:list={['lang-opt', { active: isEn }]} aria-current={isEn ? 'page' : undefined} lang="en" hreflang="en">EN</a>
      <a href={`/es/${path}`} class:list={['lang-opt', { active: !isEn }]} aria-current={!isEn ? 'page' : undefined} lang="es" hreflang="es">ES</a>
    </div>
    <a href="https://wordpress.org/plugins/enable-abilities-for-mcp/" class="btn btn-primary nav-cta">
      {t.nav.cta}
    </a>
  </div>
</nav>

<style>
nav{position:sticky;top:0;z-index:200;background:var(--paper);border-bottom:1px solid var(--border)}
.nav-inner{display:flex;align-items:center;gap:1rem;padding:.875rem 1.5rem;max-width:1100px;margin:0 auto}
.nav-logo{font-family:var(--mono);font-size:.8rem;font-weight:700;display:flex;align-items:center;gap:.4rem;white-space:nowrap;flex-shrink:0}
.sp{color:var(--accent)}
.nav-links{display:flex;gap:1.5rem;margin-left:auto}
.nav-links a{font-size:.845rem;color:var(--ink-2);transition:color .15s}
.nav-links a:hover{color:var(--ink)}
.lang-toggle{display:flex;align-items:center;gap:2px;padding:3px;border:1px solid var(--border);border-radius:999px;font-family:var(--mono);flex-shrink:0}
.lang-opt{font-size:.68rem;font-weight:700;letter-spacing:.08em;line-height:1;padding:.38rem .62rem;border-radius:999px;color:var(--fog);transition:color .15s,background .18s,box-shadow .25s}
.lang-opt:hover{color:var(--ink)}
.lang-opt.active{background:var(--accent);color:#0D1421;box-shadow:0 0 10px rgba(6,214,160,.35)}
.lang-opt.active:hover{background:var(--accent-h);color:#0D1421}
.nav-cta{white-space:nowrap}
</style>
